{% set shipment = hookable_metadata.context.shipment ?? null %}

{% if shipment and shipment.pickupPoint is not null %}
    <div class="col-12 mt-3">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" height="1.2em" width="1.2em" class="icon me-2" aria-hidden="true">
                        <path d="M9 11a3 3 0 1 0 6 0a3 3 0 0 0-6 0"></path>
                        <path d="M17.657 16.657l-4.243 4.243a2 2 0 0 1-2.827 0l-4.244-4.243a8 8 0 1 1 11.314 0z"></path>
                    </svg>
                    {{ 'app.ui.delivery_location'|trans }}
                </h3>
            </div>
            <div class="card-body">
                <p class="mb-0">
                    {{ 'app.ui.pickup_point_delivery_info'|trans }} <strong>{{ shipment.pickupPoint.name }}</strong>
                </p>
            </div>
        </div>
    </div>
{% endif %}
